{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Container `db` do docker-compose.yml (postgis), publicado em 5434 porque
    // a 5432 do host já é do Postgres do Nexora ERP. Ver .env.
    "Default": "Host=127.0.0.1;Port=5434;Database=nexoragis;Username=postgres;Password=admin;SSL Mode=Disable"
  },
  "Jwt": {
    "SigningKey": "dev-only-change-me-dev-only-change-me-32chars",
    "Issuer": "NexoraGis.Api",
    "Audience": "NexoraGis.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "GeoServer": {
    // BaseUrl é visto a partir da API (host) -> porta publicada 8600.
    "BaseUrl": "http://localhost:8600/geoserver/rest",
    // Credenciais do *GeoServer*, não do Postgres (GEOSERVER_ADMIN_* no .env).
    "Username": "admin",
    "Password": "geoserver",
    "Workspace": "nexoragis",
    // Db* é visto a partir do container do GeoServer, que fala com o `db` pelo
    // nome do serviço na rede do compose — não pelo 127.0.0.1:5434 do host.
    "DbHost": "db",
    "DbPort": 5432,
    "DbName": "nexoragis",
    "DbUser": "postgres",
    "DbPassword": "admin",
    "DbSchema": "cadastro",
    "DataStore": "nexoragis_postgis"
  }
}
