# Copiar para .env e preencher os segredos.
# .env está no .gitignore raiz do monorepo — nunca commitar segredos reais.
# Usado por: docker compose up -d --build

API_HOST=gis.e258tech.xyz
ASPNETCORE_ENVIRONMENT=Production
OPENAPI_EXPOSE=true

# POSTGRES_HOST e como a API o ve de dentro da rede `backend` (nome do
# container partilhado); POSTGRES_PORT e a porta publicada no host, usada pelo
# GeoServer (que corre no host) e pelo appsettings.Development.json.
POSTGRES_HOST=postgres
POSTGRES_DB=nexoragis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

JWT_SIGNING_KEY=
JWT_ISSUER=NexoraGis.Api
JWT_AUDIENCE=NexoraGis.Client

# Primeiro administrador (só criado com a base vazia). Apagar após o 1.º arranque.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=e258tech@gmail.com
BOOTSTRAP_ORG_CODIGO=E258
BOOTSTRAP_ORG_DESIGNACAO=e258tech

# GeoServer de produção: corre no HOST (Jetty, 8090), publicado em
# geoserver.e258tech.xyz. O container kartoza só sobe com --profile extras.
GEOSERVER_BASE_URL=http://host.docker.internal:8090/geoserver/rest
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=
GEOSERVER_WORKSPACE=nexoragis
GEOSERVER_DATASTORE=nexoragis_postgis
GEOSERVER_DB_SCHEMA=cadastro
GEOSERVER_DB_HOST=127.0.0.1
GEOSERVER_PORT=8600

# MinIO partilhado da e258tech. Nota: a API ainda não consome estas variáveis —
# Documento só guarda a referência; o upload ainda não está implementado.
MINIO_ENDPOINT=https://s3.e258tech.tech
MINIO_CONSOLE_ENDPOINT=https://minio.e258tech.tech
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_BUCKET=nexoragis
# Credenciais do container MinIO local (--profile extras).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9012
MINIO_CONSOLE_PORT=9013

REDIS_PORT=6380
