# Copiar para .env e ajustar conforme o ambiente local.
# .env está no .gitignore raiz do monorepo — nunca commitar segredos reais.

# Portas ajustadas para não colidir com os containers "pg", "minio" e
# "upbeat_bartik" (redis) já usados por outros projectos (ex: Nexora ERP)
# na mesma máquina de desenvolvimento.
POSTGRES_DB=nexoragis
POSTGRES_USER=nexoragis
POSTGRES_PASSWORD=nexoragis_dev_pw
POSTGRES_PORT=5434

MINIO_ROOT_USER=nexoragis
MINIO_ROOT_PASSWORD=nexoragis_dev_pw
MINIO_API_PORT=9012
MINIO_CONSOLE_PORT=9013

GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=nexoragis_dev_pw
GEOSERVER_PORT=8600

REDIS_PORT=6380

# JWT (autenticação da API) — gerar uma chave forte para cada ambiente.
JWT_SIGNING_KEY=dev-only-change-me-dev-only-change-me-32chars
JWT_ISSUER=NexoraGis.Api
JWT_AUDIENCE=NexoraGis.Client
