{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Postgres partilhado da máquina, publicado em 127.0.0.1:5432 e com PostGIS.
    // A palavra-passe NÃO fica aqui — este ficheiro é versionado. Definir em
    //   dotnet user-secrets set "ConnectionStrings:Default" "...;Password=..."
    // ou na variável de ambiente ConnectionStrings__Default.
    // Para trabalhar offline: `docker compose --profile extras up -d db` e
    // trocar a porta para a de POSTGRES_LOCAL_PORT (5435).
    "Default": "Host=127.0.0.1;Port=5432;Database=nexoragis;Username=postgres;SSL Mode=Disable"
  },
  "Jwt": {
    "SigningKey": "dev-only-change-me-dev-only-change-me-32chars",
    "Issuer": "NexoraGis.Api",
    "Audience": "NexoraGis.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "GeoServer": {
    // GeoServer que corre no host (Jetty, 8090) — o mesmo que produção usa.
    // O container kartoza do profile `extras` responde em 8600.
    "BaseUrl": "http://localhost:8090/geoserver/rest",
    // Credenciais do *GeoServer*, não do Postgres. Password via user-secrets
    // (GeoServer:Password) ou GeoServer__Password.
    "Username": "admin",
    "Workspace": "nexoragis",
    // Db* é visto a partir do GeoServer. Como ele corre no host, chega ao
    // Postgres pelo loopback e pela porta publicada.
    "DbHost": "127.0.0.1",
    "DbPort": 5432,
    "DbName": "nexoragis",
    "DbUser": "postgres",
    "DbSchema": "cadastro",
    "DataStore": "nexoragis_postgis"
  }
}
