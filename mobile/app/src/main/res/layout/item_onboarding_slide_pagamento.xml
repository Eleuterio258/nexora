<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_login"
    android:orientation="vertical">

    <!-- ÁREA SUPERIOR: logo da app + métodos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp">

        <!-- Logo da aplicação -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="PayCore POS"
            android:scaleType="fitCenter"
            android:src="@drawable/paycore_pos" />

        <!-- Divisor -->
        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/colorPrimary" />

        <!-- 5 métodos de pagamento -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Cartão -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="22dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Cartão" android:scaleType="fitCenter" android:padding="5dp" android:src="@drawable/logo_card" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Cartão" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>

            <!-- Dinheiro -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView android:layout_width="44dp" android:layout_height="44dp" app:cardCornerRadius="22dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Dinheiro" android:scaleType="fitCenter" android:padding="5dp" android:src="@drawable/logo_cash" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="Dinheiro" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>

            <!-- M-Pesa -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="M-Pesa" android:scaleType="fitCenter" android:padding="6dp" android:src="@drawable/logo_mpesa" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="M-Pesa" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>

            <!-- e-Mola -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="e-Mola" android:scaleType="fitCenter" android:padding="4dp" android:src="@drawable/logo_emola" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="e-Mola" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>

            <!-- QR Code -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:contentDescription="QR Code" android:scaleType="fitCenter" android:src="@drawable/logo_qrcode" />
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="QR Code" android:textColor="@color/text_secondary" android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- TEXTO inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="Múltiplos Métodos\nde Pagamento"
            android:textColor="@color/colorPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:text="Aceite Cartão, Dinheiro, M-Pesa, e-Mola e QR Code num só terminal."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
