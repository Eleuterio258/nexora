<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Câmara — fundo completo -->
    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Viewfinder ZXing (máscara escura + laser vermelho) -->
    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_possible_result_points="@color/colorPrimary"
        app:zxing_result_view="@color/colorPrimary"
        app:zxing_viewfinder_laser="@color/colorPrimary"
        app:zxing_viewfinder_mask="#CC000000" />

    <!-- ===== BARRA SUPERIOR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="14dp"
        android:paddingHorizontal="8dp">

        <!-- Botão Voltar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fechar_scanner"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:rotation="180"
            android:text=""
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="22dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/white"
            app:rippleColor="#44FFFFFF"
            app:strokeWidth="0dp" />

        <!-- Título centralizado -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="QR Code do Terminal"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Botão Lanterna -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_lanterna"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text=""
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="22dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_action_cash"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/white"
            app:rippleColor="#44FFFFFF"
            app:strokeWidth="0dp" />

    </LinearLayout>

    <!-- ===== ÁREA INFERIOR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="48dp"
        android:paddingHorizontal="32dp">

        <!-- Instrução principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/login_terminal_qr_prompt"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Instrução secundária -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="O QR Code é gerado pelo Painel Administrativo"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <!-- Logo PayCore -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:alpha="0.6"
            android:contentDescription="PayCore"
            android:scaleType="fitCenter"
            android:src="@drawable/paycore_pos" />

    </LinearLayout>

</merge>

