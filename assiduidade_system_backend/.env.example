# =============================================================================
# FaceClock API — Variáveis de Ambiente (Produção)
# =============================================================================
# Copie este ficheiro para .env e preencha os valores reais antes de arrancar.
# NUNCA commite o ficheiro .env com segredos reais.
# =============================================================================

# Ambiente: development | staging | production
ENVIRONMENT=production

# Base de dados PostgreSQL
DATABASE_URL=postgresql://postgres:ADMIN_PASSWORD@pg:5432/faceclock

# =============================================================================
# Segurança (OBRIGATÓRIO em produção — não usar os valores de exemplo)
# =============================================================================

# Chave para criptografia em repouso de templates biométricos.
# Deve ter 32 bytes (256 bits) e ser gerada de forma criptograficamente segura.
BIOMETRIC_ENCRYPTION_KEY=change-me-in-production-biometric-key-32bytes

# Segredo partilhado exclusivamente com o ERP para comprovativos de match facial.
# Gere um valor aleatório forte (>= 32 bytes) e configure o mesmo no backend Go.
FACIAL_VERIFICATION_SECRET=change-me-facial-verification-secret

# =============================================================================
# Autenticação Nexora (serviço-a-serviço / HMAC)
# =============================================================================

# Chave mestra para cifrar as credenciais Nexora em repouso (ApiCredential).
# Deve ser uma string forte (>= 32 bytes recomendado) ou uma chave Fernet válida.
# Obrigatória em produção.
NEXORA_CREDENTIAL_ENCRYPTION_KEY=change-me-nexora-credential-encryption-key

# Tolerância de relógio para validação do timestamp HMAC (segundos).
NEXORA_SIGNATURE_TTL_SECONDS=300

# Versão do protocolo HMAC enviada nos headers.
NEXORA_AUTH_VERSION=NEXORA-HMAC-SHA256-V1

# Em produção, rejeitar pedidos HMAC que não cheguem por HTTPS.
NEXORA_HMAC_REQUIRE_HTTPS=true

# Limite de chamadas por access key + IP (ex.: 100/minute).
NEXORA_RATE_LIMIT_PER_KEY=100/minute

# =============================================================================
# Redis (proteção contra replay e cache)
# =============================================================================

REDIS_URL=redis://redis:6379/0

# =============================================================================
# Integração com Nexora ERP
# =============================================================================

ERP_BASE_URL=https://api.nexora.e258tech.tech
ERP_API_KEY=
ERP_TIMEOUT_SECONDS=10

# Webhook de re-enrolamento: chamado (best-effort, autenticado com ERP_API_KEY)
# quando um template transita para PENDING_REENROLL por mudança de
# model_version. Deixar vazio desactiva a notificação — o template continua a
# ser marcado como pendente, só não há aviso ao colaborador no ERP.
ERP_REENROLL_WEBHOOK_URL=https://api.nexora.e258tech.tech/api/hardware/assiduidade/biometria/reenroll-required

# Download de imagens a partir de URLs (quando o ERP envia image_url em vez de base64)
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10
IMAGE_DOWNLOAD_MAX_BYTES=10485760

# =============================================================================
# Configurações biométricas
# =============================================================================

BIOMETRIC_QUALITY_THRESHOLD=0.55
BIOMETRIC_LIVENESS_THRESHOLD=0.68
BIOMETRIC_MATCH_THRESHOLD=0.85
FACIAL_VERIFICATION_TTL_SECONDS=90

# =============================================================================
# HTTP / CORS
# =============================================================================

# Origens permitidas pelo CORS. Em produção, especificar domínios exatos,
# separados por vírgula. Não usar "*" com allow_credentials=true.
CORS_ORIGINS=https://asseduidade.e258tech.tech

# Tamanho máximo do body (10 MB por padrão)
MAX_REQUEST_BODY_SIZE_BYTES=10485760

# =============================================================================
# Outros
# =============================================================================

APP_NAME=FaceClock API
APP_VERSION=1.0.0
DOCS_URL=/docs
OPENAPI_URL=/openapi.json

# Seed de dados de exemplo ao arrancar (false recomendado em produção)
SEED_DATA_ON_STARTUP=false

# Integração com provider de folha de pagamento (opcional)
PAYROLL_PROVIDER_BASE_URL=
PAYROLL_PROVIDER_API_KEY=
PAYROLL_PROVIDER_TIMEOUT_SECONDS=30
