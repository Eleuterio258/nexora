{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "NexoraGis.Api",
    "Audience": "NexoraGis.Client",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "AllowedHosts": "*"
}
