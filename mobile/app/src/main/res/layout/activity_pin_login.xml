<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:fitsSystemWindows="true">

    <!-- Logo horizontal -->
    <ImageView
        android:layout_width="200dp"
        android:layout_height="72dp"
        android:layout_marginTop="40dp"
        android:contentDescription="PayCore POS"
        android:src="@drawable/paycore_pos"
        android:scaleType="fitCenter" />

    <!-- Bem-vindo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Bem-vindo"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Digite seu PIN para acessar"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <!-- Dots PIN indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_pin_container"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp">

        <ImageView android:id="@+id/pin_dot_1"
            android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/pin_dot_vazio" />
        <ImageView android:id="@+id/pin_dot_2"
            android:layout_width="16dp" android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/pin_dot_vazio" />
        <ImageView android:id="@+id/pin_dot_3"
            android:layout_width="16dp" android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/pin_dot_vazio" />
        <ImageView android:id="@+id/pin_dot_4"
            android:layout_width="16dp" android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/pin_dot_vazio" />

    </LinearLayout>

    <!-- Teclado numérico -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <!-- Linha 1: 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/key_1"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="1"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/key_2"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="2"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/key_3"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="3"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Linha 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/key_4"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="4"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/key_5"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="5"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/key_6"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="6"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Linha 3: 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/key_7"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="7"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/key_8"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="8"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/key_9"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="9"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Linha 4: apagar 0 biometria -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/key_apagar"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="28dp" android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_backspace_pin"
                    android:contentDescription="Apagar" />
            </FrameLayout>

            <FrameLayout android:id="@+id/key_0"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:text="0"
                    android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/key_biometria"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_key_circle"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_fingerprint"
                    android:contentDescription="Biometria" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Botão Login -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pin_login"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:text="Login"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="12dp"
        app:elevation="0dp" />

    <!-- Sair desta conta e voltar ao login completo (email + password) -->
    <TextView
        android:id="@+id/tv_pin_terminar_sessao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="Não é você? Terminar sessão"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>

