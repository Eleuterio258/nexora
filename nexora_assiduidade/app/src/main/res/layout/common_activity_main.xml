<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_bg"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/partial_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/gestorBottomNavContainer"
        layout="@layout/partial_gestor_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Só um dos dois nav bars está visível de cada vez (role do utilizador);
         a barrier segue o topo do que estiver realmente visível, para o
         fragment_container nunca ficar por baixo da barra activa.
         barrierAllowsGoneWidgets tem de ser true (o default): em ecrãs
         secundários (addToBackStack) o LoginActivity põe as DUAS barras em
         GONE para dar o ecrã inteiro ao fragment_container — com "false" a
         barrier ficava sem nenhum widget válido para se basear e colapsava
         para 0, o que zerava a altura do fragment_container (ecrã em
         branco) sempre que se navegava para um ecrã empilhado, incluindo
         os métodos de registo de presença a partir da Home. -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomNavBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="top"
        app:constraint_referenced_ids="bottomNavContainer,gestorBottomNavContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
